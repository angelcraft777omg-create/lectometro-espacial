rules_version = '2';

// Reglas de seguridad del Lectómetro Espacial.
// Pégalas en la Consola de Firebase > Firestore Database > Reglas y pulsa "Publicar".
//
// ANTES DE PUBLICAR: cambia el correo de la función esMaestro() por el de tu
// cuenta de maestro (la que creas en Authentication > Usuarios).

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo esta cuenta puede gestionar la clase.
    // Para un segundo maestro: ... && request.auth.token.email in ['uno@centro.es', 'otro@centro.es']
    function esMaestro() {
      return request.auth != null && request.auth.token.email == 'TU_CORREO@ejemplo.com';
    }

    // Una reseña enviada por un tripulante: siempre entra como pendiente,
    // con los campos y tamaños esperados y a nombre de un tripulante que existe.
    function resenaPendienteValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['studentId', 'title', 'genre', 'pages', 'stars', 'text', 'createdAt', 'bookId', 'status'])
        && d.status == 'pending'
        && d.studentId is string
        && exists(/databases/$(database)/documents/students/$(d.studentId))
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.genre is string && d.genre.size() <= 20
        && d.text is string && d.text.size() <= 2000
        && d.pages is int && d.pages >= 1 && d.pages <= 5000
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.createdAt is string && d.createdAt.size() <= 40
        && d.bookId is string && d.bookId.size() <= 40;
    }

    // Tripulación, libros y retos: los ve cualquiera que abra la web; solo el maestro los cambia.
    match /students/{id}   { allow read: if true; allow write: if esMaestro(); }
    match /books/{id}      { allow read: if true; allow write: if esMaestro(); }
    match /challenges/{id} { allow read: if true; allow write: if esMaestro(); }

    // Códigos de acceso: se puede comprobar UN código concreto (para entrar),
    // pero solo el maestro puede ver la lista completa o cambiarla.
    match /codes/{code} {
      allow get: if true;
      allow list, write: if esMaestro();
    }

    // Reseñas: cualquiera las lee; un tripulante solo puede enviar una pendiente;
    // aceptar, editar y borrar es cosa del maestro.
    match /reviews/{id} {
      allow read: if true;
      allow create: if esMaestro() || resenaPendienteValida();
      allow update, delete: if esMaestro();
    }

    // Todo lo demás, cerrado.
    match /{document=**} { allow read, write: if false; }
  }
}
